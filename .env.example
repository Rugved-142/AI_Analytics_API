APP_NAME=ai-analytics-api
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+psycopg://analytics:analytics@localhost:5432/analytics
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true

REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=60
RATE_LIMIT_PER_MINUTE=1000

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=analytics.events
KAFKA_DLQ_TOPIC=analytics.events.dlq
KAFKA_CONSUMER_GROUP=analytics-consumer

JWT_SECRET_KEY=replace-with-strong-secret
JWT_REFRESH_SECRET_KEY=replace-with-strong-refresh-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200
BCRYPT_ROUNDS=12

AWS_REGION=us-east-1
AWS_SECRET_NAME=ai-analytics/api
